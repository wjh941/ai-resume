# ============================================================================
# 最小启动配置：个人/本地部署只需关注这一段，下面其余配置保持默认即可运行。
# ============================================================================

# development 打开 /docs 与演示登录；production 会关闭文档并强制校验密钥。
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# SQLite 单文件数据库（个人部署推荐）。WAL 自动开启。
DATABASE_PATH=./data/resume_demo.db
# 生产环境必须替换为至少 32 字节的随机密钥，且不得提交真实值；production 下默认值会被拒绝启动。
JWT_SECRET=replace-with-a-long-random-production-secret
# true 仅用于本地演示，验证码固定为 123456；生产必须设置为 false。
AUTH_DEMO_MODE=true
# 前端开发地址白名单（精确 origin，逗号分隔；生产必须填写确切 HTTPS 域名）。
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ============================================================================
# 简历与导出
# ============================================================================

# 生成的 DOCX/PDF 文件写入此目录并按 token 下载，过期自动清理。
TEMP_FILE_PATH=./temp
EXPORT_FILE_EXPIRE_MINUTES=60
# PDF 导出渲染器：playwright（需安装 playwright 并执行 `playwright install chromium`）
# 或 weasyprint（需系统级 Pango/Cairo，Docker 镜像默认使用它）。
# 两者都未安装时 PDF 导出返回明确错误，Word 导出不受影响。
PDF_RENDERER=playwright
# 可选：Playwright 浏览器缓存目录；留空则使用 playwright 的默认缓存位置。
PLAYWRIGHT_BROWSERS_PATH=
# 简历导入仅接受 PDF、Word，单位为字节；生产环境按存储与网关限制调整。
RESUME_IMPORT_MAX_FILE_BYTES=10485760

# ============================================================================
# AI 能力（可选）：不配置 KEY/MODEL 时 AI 功能返回 ai_not_configured，
# 本地知识库、职业规划、简历草稿与 Word 导出等核心功能不受影响。
# ============================================================================

AI_PROVIDER=openai_compatible
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v1
AI_API_KEY=
AI_MODEL=
# 每用户 AI 调用限流（/api/job/query、/api/job/match、/api/resume/ai-rewrite、咨询类接口）。
AI_RATE_LIMIT_MAX_REQUESTS=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
# Development-only browser setup. It accepts requests only from 127.0.0.1 and is always disabled in production.
AI_CONFIG_UI_ENABLED=true

# ============================================================================
# 登录与账号（可选进阶）
# ============================================================================

JWT_EXPIRE_HOURS=24
# 账号密码登录与短信登录并存；个人部署可设 AUTH_DEMO_MODE=false、SMS_PROVIDER=disabled，直接使用账号密码登录。
# bcrypt 成本系数。生产建议保持 12 或更高，并根据服务器性能评估。
PASSWORD_BCRYPT_ROUNDS=12
# 公开 POST /api/auth/* 的进程内限流。
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# 客户端错误上报接口的每用户限流，防止日志被灌水。
CLIENT_ERROR_RATE_LIMIT_MAX_REQUESTS=10
CLIENT_ERROR_RATE_LIMIT_WINDOW_SECONDS=60
# 仅列出可运营人员手机号；登录时会赋予 operator 角色，JWT 仍由后端校验。
OPERATOR_PHONE_ALLOWLIST=

# ============================================================================
# 数据库进阶（可选）：默认 SQLite；生产可切换 PostgreSQL。
# ============================================================================

# Production only: PostgreSQL URL. Leave blank to keep SQLite as the development default.
DATABASE_URL=
PRODUCTION=false
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Short SQLite busy wait for concurrent writes. WAL is enabled automatically at startup.
SQLITE_TIMEOUT_SECONDS=3

# ============================================================================
# 后台任务与推送（可选）：默认关闭/模拟。
# ============================================================================

# Background maintenance worker. Run it as a separate process in production.
WORKER_ENABLED=false
TASK_SCAN_INTERVAL_SECONDS=300
WORKER_LOCK_TTL_SECONDS=600
# 推送默认记录模拟发送日志；real 仅启用分发分支，真实供应商 HTTP 调用仍待后续实现。
PUSH_DISPATCHER_MODE=mock
# 未来推送供应商预留凭据：只在服务端机密存储中配置，禁止写入前端环境变量。
PUSH_SMS_ACCESS_KEY=
PUSH_SMS_ACCESS_SECRET=
PUSH_WECHAT_SUBSCRIPTION_APP_ID=
PUSH_WECHAT_SUBSCRIPTION_SECRET=
LOG_LEVEL=INFO

# ============================================================================
# 短信登录（可选）：个人部署用账号密码或演示验证码即可，无需配置。
# ============================================================================

# 后续真实短信接入选择 aliyun、tencent 或 http；本期不发送任何真实短信。
SMS_PROVIDER=disabled
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
SMS_CODE_TTL_SECONDS=300
SMS_CODE_COOLDOWN_SECONDS=60
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=

# ============================================================================
# 微信生态（可选预留）：配置后分别启用扫码登录与真实支付。
# ============================================================================

# 微信扫码占位。提供 AppID、AppSecret、HTTPS 回调域名后再实现 OAuth 回调。
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=
# 会员开关关闭时默认放行全部功能，仅用于本地兼容调试。
MEMBERSHIP_ENABLED=true
# true 仅用于开发演示；生产环境必须设为 false，随后接入签名校验后的真实渠道回调。
PAYMENT_DEMO_MODE=true
# 微信支付接入预留：配置商户号、AppID、API v3 Key 和回调验签证书后启用。
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
# 支付宝接入预留：配置 AppID、应用私钥和验签公钥后启用。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
PAYMENT_CALLBACK_SECRET=
ORDER_PAYMENT_EXPIRE_MINUTES=30
# 自动续费、优惠券、营销活动为后续迭代模块；本期不做扣款。

# ============================================================================
# 对象存储与联网搜索（可选预留）：默认本地磁盘、关闭联网。
# ============================================================================

# 一期文件仍保存在 TEMP_FILE_PATH。二期可在导出服务接入 OSS/COS，不应改变 JWT 所有权校验。
OBJECT_STORAGE_PROVIDER=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# Existing local search configuration
CACHE_EXPIRE_DAY=7
WEB_SEARCH_PROVIDER=disabled
TAVILY_API_KEY=
WEB_SEARCH_BASE_URL=https://api.tavily.com
WEB_SEARCH_MAX_RESULTS=5
