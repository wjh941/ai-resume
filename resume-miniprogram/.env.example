# H5 local development: leave this empty to use Vite's /api proxy.
# WeChat mini-program and production H5: use the public HTTPS backend address.
# This value is compiled into the client. Do not place API keys or other secrets here.
# The standalone browser frontend uses web-frontend/.env.local and VITE_API_BASE_URL instead.
VITE_RESUME_API_URL=
